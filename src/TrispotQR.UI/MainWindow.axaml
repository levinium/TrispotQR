<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TrispotQR.UI.Controls"
        xmlns:converters="clr-namespace:TrispotQR.UI.Converters"
        xmlns:vm="clr-namespace:TrispotQR.ViewModels;assembly=TrispotQR.ViewModels"
        x:Class="TrispotQR.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="TrispotQR"
        Width="1000" Height="700"
        MinWidth="760" MinHeight="560">

  <Window.Styles>
    <!-- Two treatments, named once. The styling panel alone carries seven section headings and
         a dozen field labels, and a window that spelled FontSize and FontWeight out at every one
         of them is a window where the twentieth is quietly different from the other nineteen.
         Plain type selectors, which is safe here because every element wearing these is a
         TextBlock itself: an Avalonia type selector does not match subclasses. -->
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Styles>

  <Window.Resources>
    <converters:VerdictToBrushConverter x:Key="VerdictToBrush" />
    <converters:FriendlyNameConverter x:Key="Friendly" />

    <!-- Lets a row of radio buttons stand for one property that is not a bool: the background
         choice and the three export sizes. -->
    <converters:EqualityConverter x:Key="Equality" />

    <!-- Every enum dropdown renders its items through this, so the UI says "WPA / WPA2" while
         the code and the saved files keep saying Wpa. Phase 2d's six styling dropdowns reuse
         the same key rather than each spelling out a template of their own.

         Compiled bindings are off for this one template. The binding has no path (it is the
         item itself, handed to the converter), so the compiler would otherwise type it
         against the enclosing x:DataType, MainViewModel, which is not what a ComboBox item
         is. Turning them off here is what keeps the template usable for any enum at all,
         which is the whole point of having one. -->
    <DataTemplate x:Key="FriendlyEnumTemplate" x:CompileBindings="False">
      <TextBlock Text="{Binding Converter={StaticResource Friendly}}" />
    </DataTemplate>
  </Window.Resources>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:PlainTextEditor">
      <controls:FieldBox Text="{Binding Text}" FieldName="Text" InputHeight="92"/>
    </DataTemplate>

    <DataTemplate DataType="vm:LinkEditor">
      <controls:FieldBox Label="Web address" Text="{Binding Address}" FieldName="Address"/>
    </DataTemplate>

    <!-- FieldSpacing on the container, never a Margin on the box. Nine of these call sites
         used to hand-write Margin="0,10,0,0", which is the one treatment FieldBox exists to
         own: a gap that can be forgotten on the one field nobody thought to test is exactly
         the drift the control was introduced to stop. The security label and its dropdown are
         a tighter pair, so they get their own inner panel rather than an exception to the
         rule. MainWindowTests asserts no realised FieldBox carries a Margin of its own. -->
    <DataTemplate DataType="vm:WifiEditor">
      <StackPanel Spacing="10">
        <controls:FieldBox Label="Network name" Text="{Binding Ssid}" FieldName="Ssid"/>
        <StackPanel Spacing="4">
          <TextBlock Text="Security" Classes="label"/>
          <ComboBox ItemsSource="{Binding SecurityOptions}" SelectedItem="{Binding Security}"
                    ItemTemplate="{StaticResource FriendlyEnumTemplate}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
        <controls:FieldBox Label="Password" Text="{Binding Password}" FieldName="Password"
                           IsVisible="{Binding NeedsPassword}"/>
        <CheckBox Content="This is a hidden network" IsChecked="{Binding Hidden}"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:EmailEditor">
      <StackPanel Spacing="10">
        <controls:FieldBox Label="To" Text="{Binding Address}" FieldName="Address"/>
        <controls:FieldBox Label="Subject" IsOptional="True" Text="{Binding Subject}"
                           FieldName="Subject"/>
        <controls:FieldBox Label="Message" IsOptional="True" Text="{Binding Body}"
                           FieldName="Body" InputHeight="60"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:PhoneEditor">
      <controls:FieldBox Label="Phone number" Text="{Binding Number}" FieldName="Number"/>
    </DataTemplate>

    <DataTemplate DataType="vm:SmsEditor">
      <StackPanel Spacing="10">
        <controls:FieldBox Label="Phone number" Text="{Binding Number}" FieldName="Number"/>
        <controls:FieldBox Label="Message" IsOptional="True" Text="{Binding Text}"
                           FieldName="Text" InputHeight="60"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:ContactEditor">
      <StackPanel Spacing="10">
        <!-- RowSpacing rather than a top margin on rows two and three, for the same reason the
             StackPanels use Spacing: the gap belongs to the container that arranges the fields,
             not to each field. The 10-wide middle column is the matching horizontal gutter. -->
        <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <controls:FieldBox Grid.Row="0" Grid.Column="0" Label="First name"
                             Text="{Binding FirstName}" FieldName="FirstName"/>
          <controls:FieldBox Grid.Row="0" Grid.Column="2" Label="Last name"
                             Text="{Binding LastName}" FieldName="LastName"/>
          <controls:FieldBox Grid.Row="1" Grid.Column="0" Label="Organisation"
                             Text="{Binding Organization}" FieldName="Organization"/>
          <controls:FieldBox Grid.Row="1" Grid.Column="2" Label="Job title" IsOptional="True"
                             Text="{Binding JobTitle}" FieldName="JobTitle"/>
          <controls:FieldBox Grid.Row="2" Grid.Column="0" Label="Phone" IsOptional="True"
                             Text="{Binding Phone}" FieldName="Phone"/>
          <controls:FieldBox Grid.Row="2" Grid.Column="2" Label="Email" IsOptional="True"
                             Text="{Binding Email}" FieldName="Email"/>
        </Grid>
        <controls:FieldBox Label="Website" IsOptional="True"
                           Text="{Binding Website}" FieldName="Website"/>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="*,380" Margin="16">

    <!-- Preview -->
    <Grid x:Name="PreviewArea" Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="0,0,16,0">
      <Border Grid.Row="0" Background="#F4F4F4" CornerRadius="6" Padding="16">
        <controls:QrPreview Drawing="{Binding PreviewDrawing}" />
      </Border>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                 Fill="{Binding Verdict, Converter={StaticResource VerdictToBrush}}" />
        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="2" Text="{Binding StatusDetail}" TextWrapping="Wrap"
                 Opacity="0.75" Margin="18,4,0,0" />
    </Grid>

    <!-- Controls -->
    <!--
      Avalonia's scrollbar floats above the content rather than taking a column of layout the
      way WPF's does, so without this the bar sat across the right edge of every dropdown and
      field. 16 is the measured width of the expanded bar, 4 is so the content does not touch
      it. The WPF window solved the same problem with Padding="0,0,8,0"; the port dropped it.
    -->
    <ScrollViewer Grid.Column="1" x:Name="FormScroll" Padding="0,0,20,0">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="What goes in the code" Classes="heading" />
          <ComboBox ItemsSource="{Binding ContentEditors}"
                    SelectedItem="{Binding SelectedContent}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:ContentEditor">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding SelectedContent.Hint}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
        </StackPanel>

        <!-- Named so tests can scope a visual-tree search to exactly what this presenter
             realised, rather than the whole window: FluentTheme's ComboBox template above
             carries its own internal PART_EditableTextBox even though it is never editable
             here, which would otherwise show up as a second, unrelated TextBox in a
             window-wide search. -->
        <ContentControl x:Name="ContentEditorHost" Content="{Binding SelectedContent}" />

        <!-- Problems belonging to the form rather than to any one box, and otherwise the
             informational note. A per-field problem is shown by the field itself, not here.

             The colour rides on a bound class rather than a converter: FormMessageIsProblem
             distinguishes a genuine problem from a note, and a note must not be red. Binding
             the class keeps the two colours defined in exactly one place, the application
             resources, instead of a converter holding a second copy of the same two values.

             Named so MainWindowTests can find this one TextBlock specifically, rather than
             whichever TextBlock happens to hold a given piece of text when the test runs. -->
        <TextBlock x:Name="FormMessageText" Text="{Binding SelectedContent.FormMessage}"
                   Classes.problem="{Binding SelectedContent.FormMessageIsProblem}"
                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,8,0,0"
                   IsVisible="{Binding SelectedContent.FormMessage,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock.Styles>
            <Style Selector="TextBlock.problem">
              <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
              <Setter Property="Opacity" Value="1"/>
            </Style>
          </TextBlock.Styles>
        </TextBlock>

        <TextBlock Text="{Binding CapacityText}" Opacity="0.7" FontSize="12" />

        <!-- How it looks -->
        <StackPanel Spacing="10">
          <TextBlock Text="How it looks" Classes="heading" />

          <TextBlock Text="Pick a style. Every one of these has been tested to make sure it still scans."
                     Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

          <ItemsControl x:Name="PresetsStrip" ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:CompileBindings="False">
                <Button Margin="0,0,8,8" Padding="6"
                        ToolTip.Tip="{Binding Description}"
                        Command="{Binding $parent[ItemsControl].DataContext.ApplyPresetCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Width="64" Spacing="4">
                    <controls:QrPreview Drawing="{Binding ThumbnailDrawing}" Width="54" Height="54" />
                    <TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Delete this saved style"
                                IsVisible="{Binding !IsBuiltIn}"
                                Command="{Binding $parent[ItemsControl].DataContext.DeletePresetCommand}"
                                CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="86,*">
            <TextBlock Text="Code colour" Classes="label" VerticalAlignment="Center" />
            <controls:ColorPicker x:Name="ForegroundPicker" Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  SelectedColor="{Binding Foreground}" />
          </Grid>

          <StackPanel Spacing="4">
            <TextBlock Text="Background" Classes="label" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <!-- Three choices for one property that is not a bool, so each button compares the
                   property against the value it stands for. Mode is spelled out because the
                   converter's ConvertBack is the whole mechanism: without it the buttons would
                   light up correctly and choose nothing. -->
              <RadioButton x:Name="BackgroundWhite" GroupName="Background" Content="White"
                           IsChecked="{Binding BackgroundChoice, Mode=TwoWay,
                                       Converter={StaticResource Equality}, ConverterParameter=White}" />
              <RadioButton x:Name="BackgroundTransparent" GroupName="Background" Content="Transparent"
                           ToolTip.Tip="No background at all, so the code sits on whatever is behind it"
                           IsChecked="{Binding BackgroundChoice, Mode=TwoWay,
                                       Converter={StaticResource Equality}, ConverterParameter=Transparent}" />
              <RadioButton x:Name="BackgroundCustom" GroupName="Background" Content="Custom"
                           IsChecked="{Binding BackgroundChoice, Mode=TwoWay,
                                       Converter={StaticResource Equality}, ConverterParameter=Custom}" />
              <controls:ColorPicker x:Name="CustomBackgroundPicker" VerticalAlignment="Center"
                                    SelectedColor="{Binding CustomBackground}"
                                    IsVisible="{Binding IsCustomBackground}" />
            </StackPanel>
          </StackPanel>

          <Button x:Name="SavePresetButton" Content="Save this style..."
                  Command="{Binding SavePresetCommand}" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="Save" Classes="heading" />

          <StackPanel Spacing="4">
            <TextBlock Text="Size" Classes="label" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <RadioButton x:Name="SizeSmall" GroupName="Size" Content="Small"
                           ToolTip.Tip="512 pixels. Good for a web page or an email."
                           IsChecked="{Binding PixelSize, Mode=TwoWay,
                                       Converter={StaticResource Equality}, ConverterParameter=512}" />
              <RadioButton x:Name="SizeMedium" GroupName="Size" Content="Medium"
                           ToolTip.Tip="1024 pixels. Good for a slide or a document."
                           IsChecked="{Binding PixelSize, Mode=TwoWay,
                                       Converter={StaticResource Equality}, ConverterParameter=1024}" />
              <RadioButton x:Name="SizePrint" GroupName="Size" Content="Print"
                           ToolTip.Tip="2048 pixels. Good for a printed flyer or a sign."
                           IsChecked="{Binding PixelSize, Mode=TwoWay,
                                       Converter={StaticResource Equality}, ConverterParameter=2048}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding SizeSummary}" Opacity="0.7" FontSize="12" />
          <TextBlock Text="{Binding ExportBlockedReason}" TextWrapping="Wrap" FontSize="12"
                     Foreground="#B3261E" IsVisible="{Binding !CanExport}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save PNG" Command="{Binding SavePngCommand}" />
            <Button Content="Save SVG" Command="{Binding SaveSvgCommand}" />
            <Button Content="Copy" Command="{Binding CopyCommand}" />
          </StackPanel>
        </StackPanel>

        <!--
            Advanced options, folded away. Eleven more controls unfolded on every launch would
            bury the three steps that matter, which is why the WPF window has always kept them
            behind an expander. Avalonia's Expander is the same idea with the same Header and
            IsExpanded; what differs is that its content is not in the visual tree at all until
            it is opened, which the tests have to account for.

            Each labelled group is its own named StackPanel carrying the guidance tip, rather
            than the tip sitting on the label as it does in WPF. The sentence explains the
            control, so hovering the control itself should show it, which in the WPF original it
            does not.
        -->
        <Expander x:Name="AdvancedOptions" Header="Advanced options" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">

            <TextBlock Text="Shapes" Classes="heading" />

            <StackPanel Spacing="4">
              <TextBlock Text="Dot shape" Classes="label" />
              <ComboBox x:Name="ModuleShapeBox" ItemsSource="{Binding ModuleShapes}"
                        SelectedItem="{Binding ModuleShape}"
                        ItemTemplate="{StaticResource FriendlyEnumTemplate}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel x:Name="ModuleScaleField" Spacing="4"
                        ToolTip.Tip="A bigger gap looks lighter. Too big and the code stops scanning.">
              <TextBlock Text="Gap between dots" Classes="label" />
              <Slider x:Name="ModuleScaleSlider" Minimum="0.55" Maximum="1.0" Value="{Binding ModuleScale}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Corner ring shape" Classes="label" />
              <ComboBox x:Name="MarkerFrameShapeBox" ItemsSource="{Binding MarkerFrameShapes}"
                        SelectedItem="{Binding MarkerFrameShape}"
                        ItemTemplate="{StaticResource FriendlyEnumTemplate}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="Corner centre shape" Classes="label" />
              <ComboBox x:Name="MarkerCenterShapeBox" ItemsSource="{Binding MarkerCenterShapes}"
                        SelectedItem="{Binding MarkerCenterShape}"
                        ItemTemplate="{StaticResource FriendlyEnumTemplate}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <Separator />
            <TextBlock Text="Corner colours" Classes="heading" />

            <CheckBox x:Name="UseCustomMarkerColorsBox" Content="Give the corners their own colours"
                      IsChecked="{Binding UseCustomMarkerColors}" />

            <!-- Two labelled pickers: 8 between a label and its swatch, 18 between the pairs.
                 Both gaps belong to the panel that arranges the things they separate, which is
                 why this is a nested pair of spaced StackPanels rather than a Grid with a Margin
                 on each picker. The FieldBox guard in MainWindowTests only reaches content
                 editors, so nothing but the convention itself keeps this right. -->
            <StackPanel x:Name="MarkerColorsRow" Orientation="Horizontal" Spacing="18"
                        IsVisible="{Binding UseCustomMarkerColors}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Ring" Classes="label" VerticalAlignment="Center" />
                <controls:ColorPicker x:Name="MarkerFramePicker"
                                      SelectedColor="{Binding MarkerFrameColor}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Centre" Classes="label" VerticalAlignment="Center" />
                <controls:ColorPicker x:Name="MarkerCenterPicker"
                                      SelectedColor="{Binding MarkerCenterColor}" />
              </StackPanel>
            </StackPanel>

            <Separator />
            <TextBlock Text="Outline" Classes="heading" />

            <CheckBox x:Name="OutlineEnabledBox" Content="Draw an outline around the shapes"
                      IsChecked="{Binding OutlineEnabled}" />

            <StackPanel x:Name="OutlineDetail" Spacing="10" IsVisible="{Binding OutlineEnabled}">
              <Grid ColumnDefinitions="86,*">
                <TextBlock Text="Colour" Classes="label" VerticalAlignment="Center" />
                <controls:ColorPicker x:Name="OutlinePicker" Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      SelectedColor="{Binding OutlineColor}" />
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="Thickness" Classes="label" />
                <Slider x:Name="OutlineThicknessSlider" Minimum="0.01" Maximum="0.25"
                        Value="{Binding OutlineThickness}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Applies to" Classes="label" />
                <ComboBox x:Name="OutlineTargetBox" ItemsSource="{Binding OutlineTargets}"
                          SelectedItem="{Binding OutlineTarget}"
                          ItemTemplate="{StaticResource FriendlyEnumTemplate}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>
            </StackPanel>

            <Separator />
            <TextBlock Text="Reliability" Classes="heading" />

            <StackPanel x:Name="EccField" Spacing="4"
                        ToolTip.Tip="How much damage the code can survive. Higher means it still scans if it is scratched or partly covered, but the code becomes denser.">
              <TextBlock Text="Error correction" Classes="label" />
              <ComboBox x:Name="EccBox" ItemsSource="{Binding EccLevels}" SelectedItem="{Binding Ecc}"
                        ItemTemplate="{StaticResource FriendlyEnumTemplate}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel x:Name="QuietZoneField" Spacing="4"
                        ToolTip.Tip="Clear space scanners need to find the code. 4 is the standard.">
              <TextBlock Text="Margin around the code" Classes="label" />
              <!-- A quiet zone is counted in whole modules; three and a half of them is not
                   something the renderer can draw, so the slider snaps. -->
              <Slider x:Name="QuietZoneSlider" Minimum="0" Maximum="8"
                      TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding QuietZone}" />
            </StackPanel>

            <Separator />
            <TextBlock Text="Logo" Classes="heading" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ChooseLogoButton" Content="Choose image..."
                      Command="{Binding ChooseLogoCommand}" />
              <Button x:Name="ClearLogoButton" Content="Remove"
                      Command="{Binding ClearLogoCommand}" />
              <TextBlock Text="{Binding LogoName}" VerticalAlignment="Center"
                         Opacity="0.7" FontSize="12" MaxWidth="150"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Size, shape and the error correction prompt mean nothing with no logo in the
                 code, so the whole group is collapsed until there is one. -->
            <StackPanel x:Name="LogoDetail" Spacing="10" IsVisible="{Binding HasLogo}">
              <StackPanel Spacing="4">
                <TextBlock Text="Logo size" Classes="label" />
                <Slider x:Name="LogoSizeSlider" Minimum="0.05" Maximum="0.40"
                        Value="{Binding LogoSize}" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Space around it" Classes="label" />
                <ComboBox x:Name="LogoPunchShapeBox" ItemsSource="{Binding LogoPunchShapes}"
                          SelectedItem="{Binding LogoPunchShape}"
                          ItemTemplate="{StaticResource FriendlyEnumTemplate}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>

              <!-- "Highest", not "High". FriendlyNameConverter calls EccLevel.High "Highest
                   (needed for logos)" and gives the name "High" to the lower Quartile, so a
                   button saying "High" sends the user to the wrong entry in the dropdown a few
                   controls above and this prompt stays up afterwards. -->
              <Button x:Name="RaiseEccButton" Content="Raise error correction to Highest"
                      Command="{Binding RaiseEccCommand}"
                      IsVisible="{Binding ShowRaiseEcc}"
                      HorizontalAlignment="Left" />
            </StackPanel>

            <Separator />
            <Button x:Name="ResetButton" Content="Reset everything" Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left" />

          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
