<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">

    <!--
        The light palette. Theme.Dark.xaml defines exactly the same keys, and the two are
        swapped at runtime by ThemeManager, so every key here MUST exist there as well.
        Anything referring to these from XAML has to use DynamicResource, or it will bind
        once at load and never follow a theme change.

        Only the application's own chrome lives here. The colours of a generated code come
        from the user's style and are deliberately untouched by the theme: it would be
        alarming if switching appearance quietly altered an export.
    -->

    <Color x:Key="AccentColor">#2B5CE6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2B5CE6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F49C4" />

    <!-- Text drawn on top of the accent colour. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="PageBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE0E5" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#ECEEF1" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1F27" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666E7A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B26100" />

    <!-- Input that is wrong, as opposed to merely worth a comment. Dark enough to clear
         the contrast floor as text on a white card, not only as a border. -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />

    <SolidColorBrush x:Key="HoverBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#C8CDD6" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#A9B0BA" />

    <effects:DropShadowEffect x:Key="SoftShadow"
                              BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.14" Color="#000000" />

    <!-- Checkerboard behind the preview, so a transparent background is visibly transparent
         rather than looking like a white one. -->
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E8EAED">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
