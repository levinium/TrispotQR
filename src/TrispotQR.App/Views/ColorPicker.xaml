<UserControl x:Class="TrispotQR.App.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrispotQR.App.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root">

    <Grid>
        <ToggleButton x:Name="SwatchButton"
                      Width="46" Height="28"
                      Padding="0"
                      ToolTip="Click to change this colour"
                      Style="{StaticResource SwatchToggleStyle}">
            <Border CornerRadius="3" BorderBrush="#40000000" BorderThickness="1" Margin="3">
                <Grid>
                    <!-- Checkerboard shows through when the colour is partly transparent. -->
                    <Rectangle Fill="{DynamicResource CheckerBrush}" />
                    <Rectangle x:Name="SwatchFill" />
                </Grid>
            </Border>
        </ToggleButton>

        <Popup x:Name="PickerPopup"
               IsOpen="{Binding IsChecked, ElementName=SwatchButton, Mode=TwoWay}"
               StaysOpen="False"
               AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom"
               VerticalOffset="4">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Effect="{DynamicResource SoftShadow}">
                <StackPanel Width="242">

                    <TextBlock Text="Pick a colour" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />

                    <!--
                        Saturation across, value down. Built from three stacked layers: the
                        pure hue underneath, white fading out to the right, then black
                        fading in downwards. That composition is what gives every point in
                        the square its colour without drawing a single pixel by hand.
                    -->
                    <Grid x:Name="SvSquare" Height="150"
                          Background="Transparent"
                          Cursor="Cross"
                          ToolTip="Drag to choose shade and brightness"
                          MouseLeftButtonDown="OnSquareMouseDown"
                          MouseMove="OnSquareMouseMove"
                          MouseLeftButtonUp="OnSquareMouseUp"
                          SizeChanged="OnPickerResized">
                        <Border CornerRadius="4" ClipToBounds="True"
                                BorderBrush="#30000000" BorderThickness="1">
                            <Grid>
                                <Rectangle x:Name="SvHueLayer" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#FF000000" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>

                        <!-- Not hit testable, so it can never swallow a drag. -->
                        <Canvas x:Name="SvMarkerLayer" IsHitTestVisible="False">
                            <Ellipse x:Name="SvMarker" Width="14" Height="14"
                                     Stroke="White" StrokeThickness="2"
                                     Effect="{DynamicResource SoftShadow}" />
                        </Canvas>
                    </Grid>

                    <Grid x:Name="HueStrip" Height="16" Margin="0,10,0,0"
                          Background="Transparent"
                          Cursor="Cross"
                          ToolTip="Drag to choose the colour"
                          MouseLeftButtonDown="OnHueMouseDown"
                          MouseMove="OnHueMouseMove"
                          MouseLeftButtonUp="OnHueMouseUp"
                          SizeChanged="OnPickerResized">
                        <Border CornerRadius="3" ClipToBounds="True"
                                BorderBrush="#30000000" BorderThickness="1">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0.000" Color="#FFFF0000" />
                                        <GradientStop Offset="0.167" Color="#FFFFFF00" />
                                        <GradientStop Offset="0.333" Color="#FF00FF00" />
                                        <GradientStop Offset="0.500" Color="#FF00FFFF" />
                                        <GradientStop Offset="0.667" Color="#FF0000FF" />
                                        <GradientStop Offset="0.833" Color="#FFFF00FF" />
                                        <GradientStop Offset="1.000" Color="#FFFF0000" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Border>

                        <Canvas x:Name="HueMarkerLayer" IsHitTestVisible="False">
                            <Border x:Name="HueMarker" Width="8" Height="22" CornerRadius="3"
                                    BorderBrush="White" BorderThickness="2"
                                    Effect="{DynamicResource SoftShadow}" />
                        </Canvas>
                    </Grid>

                    <TextBlock Text="Or start from a preset" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />

                    <ItemsControl x:Name="PaletteItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="26" Height="26" Margin="2"
                                        Style="{StaticResource PaletteSwatchStyle}"
                                        Background="{Binding Brush}"
                                        ToolTip="{Binding Name}"
                                        Click="OnPaletteColorClicked"
                                        Tag="{Binding Color}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Or type a colour code" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                    <TextBox x:Name="HexBox"
                             Style="{StaticResource InputStyle}"
                             KeyDown="OnHexKeyDown"
                             LostFocus="OnHexCommitted"
                             ToolTip="A hex colour such as #1B2A4A" />

                    <TextBlock x:Name="HexError"
                               Text="That is not a colour code. Try something like #1B2A4A."
                               Style="{StaticResource WarningTextStyle}"
                               Visibility="Collapsed"
                               Margin="0,4,0,0" />

                    <StackPanel Margin="0,10,0,0">
                        <local:LabelledSlider x:Name="RedSlider" Label="Red" />
                        <local:LabelledSlider x:Name="GreenSlider" Label="Green" />
                        <local:LabelledSlider x:Name="BlueSlider" Label="Blue" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
