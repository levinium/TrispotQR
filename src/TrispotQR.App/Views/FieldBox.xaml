<UserControl x:Class="TrispotQR.App.Views.FieldBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TrispotQR.App.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <StackPanel>
        <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabelStyle}" />

        <TextBox x:Name="Input"
                 Style="{StaticResource InputStyle}"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=views:FieldBox},
                                UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock x:Name="ErrorText" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
