<Window x:Class="TrispotQR.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="430"
        Background="{DynamicResource SurfaceBrush}"
        Title="Trispot QR">

    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Ellipse x:Name="Badge" Width="12" Height="12" VerticalAlignment="Center" />
            <TextBlock x:Name="HeadingText"
                       Margin="9,0,0,0"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}" />
        </StackPanel>

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="21,0,0,0"
                   Foreground="{DynamicResource TextBrush}" LineHeight="18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="92"
                    Style="{StaticResource SecondaryButtonStyle}" Click="OnCancel" />
            <Button x:Name="ProceedButton" MinWidth="120" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="OnProceed" />
        </StackPanel>
    </StackPanel>
</Window>
