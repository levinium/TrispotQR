<Window x:Class="TrispotQR.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="380"
        Background="{DynamicResource SurfaceBrush}"
        Title="Trispot QR">

    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="Input" Style="{StaticResource InputStyle}" MaxLength="60" />

        <TextBlock x:Name="ErrorText"
                   Style="{StaticResource WarningTextStyle}"
                   Visibility="Collapsed"
                   Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Width="86" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Save" IsDefault="True" Width="86" Margin="8,0,0,0"
                    Click="OnAccept" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
