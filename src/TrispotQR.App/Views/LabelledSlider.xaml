<UserControl x:Class="TrispotQR.App.Views.LabelledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelText" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" />
        <Slider x:Name="Bar" Grid.Column="1" Minimum="0" Maximum="255" VerticalAlignment="Center" />
        <TextBlock x:Name="ValueText" Grid.Column="2" VerticalAlignment="Center"
                   TextAlignment="Right" Style="{StaticResource CaptionStyle}" />
    </Grid>
</UserControl>
