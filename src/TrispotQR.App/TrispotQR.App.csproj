<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TrispotQR.App</RootNamespace>
    <AssemblyName>TrispotQR</AssemblyName>
    <Product>Trispot QR</Product>
    <Description>Standalone QR code generator with styling, PNG/SVG export and live scannability checking.</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <!-- Required for single-file self-contained WPF: the native WPF libraries must be
         extracted to disk rather than loaded from the bundle. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- SkiaSharp's native asset packages ship libSkiaSharp.pdb (89 MB, a native debug symbol
       file with no runtime purpose) next to libSkiaSharp.dll under runtimes/<rid>/native/.
       That arrives via NativeCopyLocalItems, a NuGet RID-asset item that DebugType=none and
       AllowedReferenceRelatedFileExtensions do not touch (both only govern managed reference
       companion files). Strip .pdb from it here so dist holds only the exe, as it did before
       this phase.

       AfterTargets="ResolvePackageAssets" is sufficient on its own, with no BeforeTargets:
       the first target that actually reads @(NativeCopyLocalItems) is
       ResolveLockFileCopyLocalFiles, and that target depends on ResolvePackageAssets, so
       MSBuild's own dependency graph guarantees this runs before anything consumes the item.
       (An earlier version of this target also listed a BeforeTargets naming
       "_ComputeResolvedFilesToPublishList" — that target does not exist in the .NET 10 SDK,
       so MSBuild silently ignored it. It looked load-bearing and was not; the ordering has
       always come from AfterTargets alone. Don't re-add a BeforeTargets guess here without
       confirming the target name actually exists.) -->
  <Target Name="RemoveNativeSkiaSharpPdb" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\TrispotQR.Core\TrispotQR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach ColorPicker's retained hue and saturation, which are the
         part of it most likely to regress without anyone noticing. -->
    <InternalsVisibleTo Include="TrispotQR.Tests" />
  </ItemGroup>

</Project>
