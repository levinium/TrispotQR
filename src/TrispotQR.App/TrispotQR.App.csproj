<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TrispotQR.App</RootNamespace>
    <AssemblyName>TrispotQR</AssemblyName>
    <Product>Trispot QR</Product>
    <Description>Standalone QR code generator with styling, PNG/SVG export and live scannability checking.</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <!-- Required for single-file self-contained WPF: the native WPF libraries must be
         extracted to disk rather than loaded from the bundle. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- SkiaSharp's native asset packages ship libSkiaSharp.pdb (89 MB, a native debug symbol
       file with no runtime purpose) next to libSkiaSharp.dll under runtimes/<rid>/native/.
       That arrives via NativeCopyLocalItems, a NuGet RID-asset item that DebugType=none and
       AllowedReferenceRelatedFileExtensions do not touch (both only govern managed reference
       companion files). Strip .pdb from it before the publish file list is computed, so dist
       holds only the exe, as it did before this phase. -->
  <Target Name="RemoveNativeSkiaSharpPdb" AfterTargets="ResolvePackageAssets" BeforeTargets="_ComputeResolvedFilesToPublishList;GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\TrispotQR.Core\TrispotQR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach ColorPicker's retained hue and saturation, which are the
         part of it most likely to regress without anyone noticing. -->
    <InternalsVisibleTo Include="TrispotQR.Tests" />
  </ItemGroup>

</Project>
