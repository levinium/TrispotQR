<Application x:Class="TrispotQR.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrispotQR.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Order matters. Slot 0 is the palette and ThemeManager replaces it in
                    place to switch appearance, so nothing else may be inserted before it.
                    The styles that follow refer to these colours with DynamicResource.
                -->
                <ResourceDictionary Source="Theme.Light.xaml" />
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Segoe UI everywhere, matching the rest of Windows. -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
