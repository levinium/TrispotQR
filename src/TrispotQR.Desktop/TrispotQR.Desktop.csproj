<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrispotQR</AssemblyName>
    <!-- WinExe suppresses the console window on Windows and means nothing on Linux and macOS,
         where it is simply ignored. -->

    <!-- The single source of truth for what the app calls itself and which build it is. This
         is the entry assembly, so it is the one AppInfo reads; the title bar, the About window
         and the published file all follow from these two lines.

         From 1.1.0 this is also the version of the product as a whole: publish.ps1 ships this
         project, so TrispotQR.App's own <Version> now describes only the WPF build nobody
         downloads, and stays at 1.0.0 until Phase 2f retires it. -->
    <Version>1.1.0</Version>
    <Product>Trispot QR</Product>

    <!-- What Explorer, the taskbar and a pinned shortcut show. Points at the copy in
         TrispotQR.UI rather than carrying its own, so the executable's icon and the window's
         icon cannot drift apart. Conditioned so a missing file is a warning at worst rather
         than a build break. -->
    <ApplicationIcon Condition="Exists('..\TrispotQR.UI\Assets\app.ico')">..\TrispotQR.UI\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The same fix TrispotQR.App carries, and needed here for the same reason. SkiaSharp's and
       HarfBuzzSharp's native packages ship a .pdb beside each native library (85 MB and
       20 MB of debug symbols with no runtime purpose), and they arrive through
       NativeCopyLocalItems, which DebugType=none does not govern. Without this, v1.1.0's first
       zips came out at 70 MB instead of 45, almost all of it those two files.

       AfterTargets="ResolvePackageAssets" alone is enough: the first target that reads the item
       depends on that one, so MSBuild's own graph orders this before anything consumes it.
       TrispotQR.App's comment records why no BeforeTargets guess belongs here. -->
  <Target Name="RemoveNativePdbs" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrispotQR.UI\TrispotQR.UI.csproj" />
  </ItemGroup>

</Project>
