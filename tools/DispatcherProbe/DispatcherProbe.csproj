<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately not in TrispotQR.slnx and not in CI. It needs a real desktop session and a
    real Win32 message queue, it is Windows-only, and it is run by hand when the sync-over-
    async bridge changes rather than on every push. See Program.cs for what it proves and how
    to run it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DispatcherProbe</AssemblyName>
    <RootNamespace>DispatcherProbe</RootNamespace>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TrispotQR.UI\TrispotQR.UI.csproj" />
  </ItemGroup>

</Project>
